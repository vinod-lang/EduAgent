# Server-only origin used by the same-origin Next proxy. No production secrets.
EDUAGENT_API_BACKEND_URL=http://127.0.0.1:8000
# Explicit trusted-local development only. Production builds always refuse dev login.
EDUAGENT_FRONTEND_MODE=development
EDUAGENT_FRONTEND_DEV_AUTH=true
EDUAGENT_DEV_ALIASES=professor-a,professor-b
# Set privately to the same random key as FastAPI. Never NEXT_PUBLIC.
EDUAGENT_DEV_ACCESS_KEY=
